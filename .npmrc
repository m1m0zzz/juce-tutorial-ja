# 下の設定は npm 11.16 以降でしか効かない。古い npm では黙って無視されるため engines と対にして弾く
engine-strict=true

# 依存の install script は既定で拒否し、package.json の allowScripts で個別に許可する
strict-allow-scripts=true

# git 依存は package.json に書いたものだけ許可する（npm 12 の既定は none）
allow-git=root

# npm 12 の既定（none）だと、bundleDependencies を持つパッケージで誤って EALLOWREMOTE になる（npm/cli#9800）。直ったら消す
# npm 11 の既定は all
allow-remote=all

# 公開直後の版は入れない
min-release-age=3

# renovate を導入しているため基本 skip する
audit=false
fund=false
